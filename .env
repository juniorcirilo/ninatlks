
# Postgres — usa a stack compartilhada (container "postgresql", rede srv_default).
# Usuário/DB dedicados criados em 2026-07-20 (role "ninatlks_app", database "ninatlks").
DATABASE_URL="postgres://ninatlks_app:d24471da7fd3ddf88bff5aab329afb7dc5d385510eae3cb4@postgresql:5432/ninatlks"

# Redis — usa a stack compartilhada (container "redis", rede srv_default).
# Isolado no DB lógico 2 (DB 0 é usado por outra app, DB 1 tem 1 chave residual).
REDIS_URL="redis://:CjHKT4mKWdVxhWCcpKktdgRjbXcmfPWq@redis:6379/2"

# MinIO — usa a stack compartilhada (container "minio", rede srv_default).
# Access key dedicada "ninatlks_app" criada em 2026-07-20, restrita ao bucket "ninatlks"
# (policy ninatlks-app-policy, sem acesso aos demais buckets: evolution, livechat, nina, etc).
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="ninatlks_app"
S3_SECRET_KEY="8114721188e8ac21dc753069382cae6c76afe599f6fb16e3"
S3_ATTACHMENTS_BUCKET="ninatlks"

# Web + API (mesmo container, ver Dockerfile/package.json:start:all)
API_PORT="3001"
WEB_HOST_PORT="30004"
API_HOST_PORT="30001"
# Deixe WEB_ORIGIN unset para o main.ts cair no fallback `origin: true`
# (reflete o Origin da requisição) — "*" quebra o CORS porque o app usa
# credentials: true, e navegadores bloqueiam a combinação de
# Access-Control-Allow-Origin: * com credenciais.
#
# Domínio real: utalks.ubva.com.br (nginx já configurado, ver
# /etc/nginx/sites-enabled/utalks.ubva.com.br.conf) proxeia / -> :30004 (web)
# e /auth, /accounts, /agent-tools, /health, /invites, /system-settings,
# /webhooks, /socket.io -> :30001 (API), então API e web ficam na mesma
# origem por trás do domínio — sem isso, o navegador do usuário tentaria
# "localhost:30001" na própria máquina dele, não no servidor.
VITE_API_URL="https://utalks.ubva.com.br"
# Base pública da API usada pra montar as URLs de webhook que registramos nos
# provedores (Twilio voice/sms/status, Meta, Evolution). Sem isso o default do
# env.validation.ts é "http://localhost:3001", e a Twilio recusa o número
# (URL não pública) — além de, se aceitasse, as chamadas nunca chegarem aqui.
# Mesmo domínio do VITE_API_URL: o nginx manda /webhooks -> :30001 (API).
PUBLIC_API_URL="https://utalks.ubva.com.br"


# Google OAuth (Calendar/Meet) — crie um projeto em console.cloud.google.com,
# habilite a Google Calendar API e crie credenciais OAuth 2.0 "Web application"
# com redirect URI "${PUBLIC_API_URL}/google-calendar/callback".
# IMPORTANTE: o nginx de utalks.ubva.com.br hoje só proxeia /accounts (que já
# cobre /accounts/:id/google-calendar/*) — falta adicionar /google-calendar
# à lista de paths proxiados para :30001, senão o callback do Google cai no
# front (porta 30004) em vez da API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (e-mail de confirmação de reunião) — chave em resend.com/api-keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nina Talks <no-reply@ubva.com.br>"

# Evolution (WhatsApp) — necessário para provisionar instância em
# Configurações → Integrações e validar webhooks recebidos em /webhooks/evolution/incoming.
EVOLUTION_WEBHOOK_SECRET=b01298fecf371b98628d017f9f13e3be878e0e94c59fe385f9987bc9198f6e88

