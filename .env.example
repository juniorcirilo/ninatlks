# Postgres (novo backend)
POSTGRES_USER=ninatlks
POSTGRES_PASSWORD=
POSTGRES_DB=ninatlks
DATABASE_URL=postgres://ninatlks:CHANGE_ME@postgres:5432/ninatlks
POSTGRES_HOST_PORT=54320

# Redis (filas/cron do novo backend)
REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=63079

# MinIO (storage S3-compatible do novo backend)
MINIO_ROOT_USER=ninatlks
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ninatlks
S3_SECRET_KEY=CHANGE_ME
MINIO_HOST_PORT=30008
MINIO_CONSOLE_HOST_PORT=30009

# Web + API (mesmo container, ver Dockerfile/package.json:start:all)
API_PORT=3001
WEB_HOST_PORT=30004
API_HOST_PORT=30001
WEB_ORIGIN=http://localhost:30004
# URL da API vista PELO NAVEGADOR (porta host, não a interna do container) — ver src/lib/api-client.ts
VITE_API_URL=http://localhost:30001

# Sessão (cookie httpOnly opaco, ver server/src/modules/auth)
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=2592000

# Storage (bucket de attachments no MinIO)
S3_ATTACHMENTS_BUCKET=attachments
