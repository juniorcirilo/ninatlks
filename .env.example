# Postgres (novo backend)
POSTGRES_USER=ninatlks
POSTGRES_PASSWORD=
POSTGRES_DB=ninatlks
DATABASE_URL=postgres://ninatlks:CHANGE_ME@postgres:5432/ninatlks
POSTGRES_HOST_PORT=54320

# Redis (filas/cron do novo backend)
REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=63079

# MinIO (storage S3-compatible do novo backend)
MINIO_ROOT_USER=ninatlks
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
# Host público do MinIO (links assinados que o navegador abre); vazio = usa S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=ninatlks
S3_SECRET_KEY=CHANGE_ME
MINIO_HOST_PORT=30008
MINIO_CONSOLE_HOST_PORT=30009

# Web + API (mesmo container, ver Dockerfile/package.json:start:all)
API_PORT=3001
WEB_HOST_PORT=30004
API_HOST_PORT=30001
WEB_ORIGIN=http://localhost:30004
# URL da API vista PELO NAVEGADOR (porta host, não a interna do container) — ver src/lib/api-client.ts
VITE_API_URL=http://localhost:30001

# Sessão (cookie httpOnly opaco, ver server/src/modules/auth)
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=2592000

# Storage (bucket de attachments no MinIO)
S3_ATTACHMENTS_BUCKET=attachments

# Base pública da API — usada para montar callback URLs de provedores
# (Twilio, Evolution, ElevenLabs e agora Google OAuth). Em produção, aponte
# para o domínio público (ex.: https://seu-dominio.com).
PUBLIC_API_URL=http://localhost:30001

# Google OAuth (Calendar/Meet) — crie um projeto em console.cloud.google.com,
# habilite a Google Calendar API e crie credenciais OAuth 2.0 do tipo
# "Web application" com redirect URI "${PUBLIC_API_URL}/google-calendar/callback".
# Pode também ser configurado por conta em Configurações → Integrações (o valor
# por conta tem prioridade sobre estas variáveis).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional — por padrão é derivado de PUBLIC_API_URL + /google-calendar/callback.
GOOGLE_OAUTH_REDIRECT_URI=

# SMTP (envio do e-mail de confirmação de reunião) — qualquer provedor com
# conta de e-mail SMTP: Hostgator/cPanel, Gmail, Zoho, o relay SMTP da Resend
# etc. Pode também ser configurado por conta em Configurações → Integrações
# (o valor por conta tem prioridade sobre estas variáveis).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Opcional — por padrão usa o próprio SMTP_USER como remetente.
SMTP_FROM_EMAIL="Utalks <no-reply@seu-dominio.com>"

# Resend (canal de E-MAIL do Omnichannel — enviar/receber mensagens como
# conversa, não confundir com o e-mail de confirmação de reunião acima, que
# agora é via SMTP). Chave em resend.com/api-keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Utalks <no-reply@seu-dominio.com>"

# WhatsApp (Baileys): pasta das sessões, uma subpasta por canal (<id>/auth, <id>/storage).
# Em Docker, monte esta pasta num volume (docker-compose.yml) para não perder o login a cada deploy.
WA_SESSIONS_DIR=/data/sessions
# Nível de log do Baileys (silent|error|warn|info|debug).
WA_LOG_LEVEL=silent

# STT/TTS próprio (/srv/containers/tts-stt). Sem STT_URL a transcrição fica desligada.
STT_URL=http://tts-stt:8000
STT_API_KEY=
STT_LANGUAGE=pt
TTS_VOICE=pt_BR-faber-medium

# Quantos proxies (nginx) ficam na frente da API; usado no rate limit por IP.
TRUST_PROXY_HOPS=1
